              ],
              "port": "8080",
              "path": [
                "api",
                "imagenes",
                "upload"
              ]
            },
            "description": "Generated from cURL: curl -X POST \"http://localhost:8080/api/imagenes/upload\" -H \"Authorization: Bearer {{jwt_token}}\" -F \"file=@\" -F \"productoId={{producto_id}}\" -F \"esPortada=false\""
          },
          "response": []
        },
        {
          "name": "Reordenar Imagen (Cambiar Orden / Portada)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}",
                "disabled": false
              }
            ],
            "url": {
              "raw": "http://localhost:8080/api/imagenes/{{imagen_id}}/orden?nuevoOrden=1",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
                "imagenes",
                "{{imagen_id}}",
                "orden"
              ],
              "query": [
                {
                  "key": "nuevoOrden",
                  "value": "1"
                }
              ]
            },
            "description": "Reordena una imagen. nuevoOrden=1 equivale a marcarla como portada (principal). Ejemplo: nuevoOrden=3 mueve la imagen a la posición 3."
          },
          "response": []
        }
